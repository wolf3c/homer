@@ -0,0 +1,39 @@
+// Build input is an explicit committed tree. Preparation overlays are finite,
+// opt-in, recorded, and never represented as a publishable committed build.
+import {execFileSync} from 'node:child_process';
+import {readFileSync,writeFileSync,mkdirSync,existsSync,cpSync,lstatSync,realpathSync} from 'node:fs';
+import {resolve,join,dirname} from 'node:path';
+import {createHash} from 'node:crypto';
+export const DESKTOP_CANDIDATE_PATHS=[
+ 'packaging/macos/HomerApplication.swift','packaging/macos/ImageDecoder.swift','packaging/macos/Info.plist',
+ 'packaging/macos/dependencies-lock.json','packaging/macos/distribution-policy.json','packaging/macos/node-distribution-entitlements.plist',
+ 'scripts/build-macos-desktop.mjs','scripts/desktop-source.mjs','scripts/desktop-runtime.mjs','scripts/desktop-profile.mjs',
+ 'scripts/prepare-desktop-dependencies.mjs','scripts/macos-distribution.mjs','scripts/dev.mjs','scripts/seamless-synthetic-fixture.mjs',
+ 'src/desktop-resources.ts','src/desktop-management.ts','src/config.ts','src/dev-host.ts','src/service.ts','src/engine.ts','src/media-decode.ts','ui/homer-app.tsx',
+];
+const sha=bytes=>createHash('sha256').update(bytes).digest('hex');
+export function prepareDesktopSource({root,sourceSha,stage,prepareCandidate=false}){
+ root=realpathSync(root);stage=resolve(stage);
+ if(!/^[a-f0-9]{40}$/.test(sourceSha??''))throw Error('desktop_full_git_sha_required');
+ if(!stage.startsWith(join(root,'.codex/scratch/'))||existsSync(stage))throw Error('desktop_fresh_source_stage_required');
+ mkdirSync(dirname(stage),{recursive:true});
