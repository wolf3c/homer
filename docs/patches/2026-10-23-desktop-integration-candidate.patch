+        }
+    }
+    private func testAccountScreen() {
+                guard let origin = self.actualOrigin else { return }
+                self.web.load(URLRequest(url: origin.appendingPathComponent("settings/capabilities")))
+                DispatchQueue.main.asyncAfter(deadline: .now() + 3) { [weak self] in
+                    guard let self else { return }
+                    self.web.evaluateJavaScript("({path:location.pathname,text:document.body.innerText.slice(0,3000),overflow:document.documentElement.scrollWidth>innerWidth})") { value, error in
+                        self.record("account_settings", ["value": value ?? NSNull(), "error": error != nil])
+                        self.web.takeSnapshot(with: WKSnapshotConfiguration()) { image, _ in
+                            if let image, let tiff = image.tiffRepresentation, let bitmap = NSBitmapImageRep(data: tiff), let png = bitmap.representation(using: .png, properties: [:]) { try? png.write(to: self.testEvidence!.appendingPathComponent("homer-account-settings.png")) }
+                            self.testQuit(confirm: false)
+                            DispatchQueue.main.asyncAfter(deadline: .now() + 1) { self.testQuit(confirm: true) }
+                        }
+                    }
+                }
+    }
+    private func testQuit(confirm: Bool) {
+        guard testEvidence != nil else { return }
