+                    // Fixed synthetic fixture only; no general script/file bridge.
+                    let seed = "sessionStorage.setItem('homer-draft:synthetic-desktop-main',JSON.stringify({text:'Synthetic retained draft 中文',requestId:'synthetic-first-open-draft'}));"
+                    web.configuration.userContentController.addUserScript(WKUserScript(source: seed, injectionTime: .atDocumentStart, forMainFrameOnly: true))
+                }
+            }
