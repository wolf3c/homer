+    func applicationDidFinishLaunching(_ notification: Notification) {
+        let others = NSRunningApplication.runningApplications(withBundleIdentifier: Bundle.main.bundleIdentifier ?? "app.homer.desktop.candidate")
+            .filter { $0.processIdentifier != ProcessInfo.processInfo.processIdentifier }
+        if let other = others.first { other.activate(options: []); NSApp.terminate(nil); return }
+        NSApp.setActivationPolicy(.regular)
+        installMenu()
+        createWindow()
+        NSApp.activate(ignoringOtherApps: true)
+        do {
+            let args = CommandLine.arguments
+            if let at = args.firstIndex(of: "--test-profile"), at + 1 < args.count {
+                let profile = URL(fileURLWithPath: args[at + 1], isDirectory: true).standardizedFileURL
+                guard profile.path.hasPrefix("/"), profile.path != "/", FileManager.default.fileExists(atPath: profile.appendingPathComponent(".homer-desktop-test-profile").path) else { throw AppError.invalidTestProfile }
+                testProfile = profile
+                if args.contains("--self-test") { testEvidence = profile.appendingPathComponent("wk-evidence", isDirectory: true); try FileManager.default.createDirectory(at: testEvidence!, withIntermediateDirectories: true) }
+                firstOpenProbe = testEvidence != nil && args.contains("--first-open-probe")
