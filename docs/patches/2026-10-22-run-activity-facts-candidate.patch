+// Public, fixed-template facts only. Never a tool argument/output archive.
+export type ActivityAction='inspect_task'|'inspect_run'|'inspect_file'|'inspect_attachment'|'review_result'|'prepare_delivery'|'create_task';
+export type ActivityOutcome='record_read'|'file_read'|'attachment_read'|'extraction_unavailable'|'accepted'|'changes_requested'|'rejected'|'review_required'|'delivery_prepared'|'delivery_recorded'|'created';
+export type ActivityTarget={taskId:string;version:number;runId?:string;resultId?:string;deliveryId?:string};
+export type PublicActivity={schemaVersion:1;action:ActivityAction;objectName?:string;outcome:ActivityOutcome;target?:ActivityTarget};
+// Web-only, freshly authorized navigation, never persisted with the historical fact.
+export type ActivityLink={task:ActivityTarget&{rootTaskId:string};artifact?:{id:string;title:string};messageId?:string};
+export const activityActions:Record<ActivityAction,string>={inspect_task:'查看任务记录',inspect_run:'查看执行记录',inspect_file:'检查成果文件',inspect_attachment:'读取附件材料',review_result:'验收成果',prepare_delivery:'准备正式交付',create_task:'创建任务'};
+export const activityOutcomes:Record<ActivityOutcome,string>={record_read:'记录已读取',file_read:'文件已读取',attachment_read:'材料已读取',extraction_unavailable:'附件记录已读取，内容当前不可读',accepted:'验收已接受',changes_requested:'已要求修改',rejected:'验收未接受',review_required:'验收决定待明确',delivery_prepared:'交付已准备，正式交付尚未确认',delivery_recorded:'正式交付回执已记录',created:'任务已创建'};
+// Only already-public display names; reject path-like or control-laden values.
+export function publicActivityName(value:unknown):string|undefined{
+ if(typeof value!=='string'||!value.trim()||value.length>240||/[\x00-\x1f\x7f/\\]/.test(value)||/https?:|file:|Bearer |(?:api[_-]?key|token|password)\s*[:=]/i.test(value))return;
+ return value.trim();
+}
