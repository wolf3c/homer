+    fn is_homer_main_instructions(text: &str) -> bool {
+        // The legacy content kind is shared with namespace updates. Homer appends
+        // this footer independently of the configured main prompt text.
+        text.ends_with("。Worker 可选择获准的项目目录。") && text.contains("\n默认工作目录：")
+    }
+
+    fn homer_main_instruction_part(item: &ResponseItem) -> Option<(usize, &str)> {
+        let ResponseItem::Message {
+            role,
+            content,
+            internal_chat_message_metadata_passthrough: Some(metadata),
+            ..
+        } = item
+        else {
+            return None;
+        };
+        let kinds = metadata.content_item_kinds.as_deref()?;
+        if role != "developer" || kinds.len() != content.len() {
+            return None;
+        }
+        content
+            .iter()
+            .zip(kinds)
+            .enumerate()
+            .find_map(|(index, (part, kind))| {
+                if kind.as_str() == "generic.developer_instructions"
+                    && let ContentItem::InputText { text } = part
+                    && Self::is_homer_main_instructions(text)
+                {
+                    Some((index, text.as_str()))
+                } else {
+                    None
+                }
+            })
+    }
+
+    fn update_homer_main_instruction_part(
+        item: &mut ResponseItem,
+        replacement: &mut Option<&str>,
+    ) -> bool {
+        let Some((index, _)) = Self::homer_main_instruction_part(item) else {
+            return true;
+        };
+        let ResponseItem::Message {
+            content,
+            internal_chat_message_metadata_passthrough: Some(metadata),
+            ..
+        } = item
+        else {
+            return true;
+        };
+        if let Some(replacement) = replacement.take() {
+            if let ContentItem::InputText { text } = &mut content[index]
+                && text.as_str() != replacement
+            {
+                text.clear();
+                text.push_str(replacement);
+            }
+        } else {
+            if let Some(kinds) = metadata.content_item_kinds.as_mut() {
+                kinds.remove(index);
+            }
+            content.remove(index);
+        }
+        !content.is_empty()
+    }
+
