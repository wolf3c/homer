+++ b/tests/legacy-activity-reading-ui.test.mjs
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import React from 'react';
+import {ProcessNodeView,ProcessDetailsContext} from './helpers/process-ui-loader.mjs';
+import {withDom} from './helpers/process-dom.mjs';
+const h=React.createElement;
+const call=(id,status='completed',extra={})=>({id,kind:'tool',seq:Number(id.replace(/\D/g,''))||1,revision:1,category:'host',label:'检查资料',status,...extra});
+const node=items=>({id:'node',threadId:'thread',seq:1,revision:1,sourceKind:'user',sourceMessageIds:[],messageId:'node',state:'working',status:'running',turnIds:['turn'],items});
+const rows=d=>d.all().filter(n=>n.attrs['data-tool-id']).map(n=>n.attrs['data-tool-id']);
+test('returned internal calls without facts have one honest reading entry and unchanged count',async()=>withDom(async d=>{
+ const items=Array.from({length:12},(_,i)=>call('call-'+(i+1))),value=node(items),original=JSON.stringify(value);
+ await d.render(h(ProcessNodeView,{node:value,renderText:t=>t}));
+ assert.deepEqual(rows(d),[]);
+ assert.equal(d.all().filter(n=>n.tagName==='BUTTON'&&n.textContent==='查看原调用记录').length,1);
+ assert.match(d.container.textContent,/12 次内部调用缺少公开工作详情/);
+ assert.equal(JSON.stringify(value),original);
+ await d.render(h(ProcessNodeView,{node:{...value,revision:2,state:'worked',status:'completed'},renderText:t=>t}));
+ assert.match(d.container.textContent,/12 次调用已返回/);
+}));
+test('mixed facts, native calls and every unsettled or abnormal internal call remain in order through updates',async()=>withDom(async d=>{
+ const fact={schemaVersion:1,action:'inspect_task',objectName:'公开事项',outcome:'record_read'};
+ const items=[call('call-1'),call('call-2','completed',{activity:fact}),call('call-3'),...['running','failed','declined','interrupted','unknown','blocked'].map((s,i)=>call('call-'+(i+4),s)),call('call-10','completed',{category:'command'}),call('call-11','completed',{category:undefined})];
+ const render=items=>d.render(h(ProcessNodeView,{node:node(items),renderText:t=>t}));
+ await render(items);
+ assert.deepEqual(rows(d),items.filter(i=>!['call-1','call-3'].includes(i.id)).map(i=>i.id));
+ assert.match(d.container.textContent,/查看任务记录：公开事项/);
+ for(const status of ['调用失败','调用被拒绝','调用已中断','结束状态待核实','调用受阻'])assert.match(d.container.textContent,new RegExp(status));
+ await render([...items,call('call-4','completed',{revision:2,activity:fact})]);
+ assert.deepEqual(rows(d),items.filter(i=>!['call-1','call-3'].includes(i.id)).map(i=>i.id));
+ assert.equal(d.all().filter(n=>n.attrs['data-tool-id']==='call-4').length,1);
+ await render([...items,call('call-4','completed',{revision:3})]);
+ assert.equal(rows(d).includes('call-4'),false);
+ assert.match(d.container.textContent,/3 次内部调用缺少公开工作详情/);
+}));
+test('historical calls stay lazy, preserve manual reopening and show one entry after the exact read',async()=>withDom(async d=>{
+ const detail={...node([call('call-1'),call('call-2')]),state:'worked',status:'completed'},header={...detail,items:[],details:'unloaded',toolStatusCounts:{completed:2}};
+ let reads=0;const load=async()=>{reads++;return detail;};
+ const render=()=>d.render(h(ProcessDetailsContext.Provider,{value:load},h(ProcessNodeView,{node:header,renderText:t=>t})));
+ await render();assert.equal(reads,0);
+ const toggle=d.find(n=>n.tagName==='BUTTON');await d.click(toggle);await render();
+ assert.equal(reads,1);assert.deepEqual(rows(d),[]);assert.match(d.container.textContent,/2 次内部调用缺少公开工作详情/);
+ await d.click(toggle);await d.click(toggle);await render();
+ assert.equal(toggle.attrs['aria-expanded'],'true');assert.deepEqual(rows(d),[]);
+}));
