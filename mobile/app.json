{
  "expo": {
    "name": "Homer",
    "slug": "homer-mobile",
    "version": "0.1.1",
    "orientation": "default",
    "ios": {
      "bundleIdentifier": "com.homer.mobile",
      "supportsTablet": false,
      "buildNumber": "7"
    },
    "android": {
      "package": "com.homer.mobile",
      "permissions": [
        "CAMERA",
        "android.permission.ACCESS_LOCAL_NETWORK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "../assets/branding/mobile/android-adaptive.png",
        "backgroundColor": "#0645AD"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 37
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "用相机扫描 Homer 主端的连接二维码。",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "icon": "../assets/branding/mobile/mobile-icon.png"
  }
}
